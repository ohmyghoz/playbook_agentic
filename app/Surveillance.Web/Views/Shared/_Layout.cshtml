<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pengawasan pasar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Surveillance.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Investigation" asp-action="Index">Pengawasan pasar</a>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Investigation" asp-action="Index">Investigasi UMA</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Approvals" asp-action="Index">Antrean approval</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a id="jobs-nav" class="nav-link text-dark" asp-controller="Jobs" asp-action="Index"
                               data-badge-url="@Url.Action("Badge", "Jobs")"
                               data-hub-url="@Url.Content("~" + Surveillance.Web.Hubs.InvestigationHub.Path)">
                                Deteksi pola <span id="jobs-badge" class="badge text-bg-warning d-none"></span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole(Surveillance.Web.Auth.Roles.Supervisor))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Settings" asp-action="Index">Setting</a>
                        </li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form class="ms-auto d-flex align-items-center gap-2" asp-controller="Account" asp-action="Logout" method="post">
                        <span class="small text-muted">@User.Identity.Name</span>
                        <button type="submit" class="btn btn-link btn-sm p-0">Keluar</button>
                    </form>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container small">
            Hasil agent adalah indikasi untuk ditelaah analis, bukan kesimpulan pelanggaran.
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="job-notice" class="job-notice alert alert-info shadow d-none" role="status" aria-live="polite">
            <span data-part="notice-text"></span>
            <a class="ms-1">Buka job</a>
            <button type="button" class="btn-close btn-sm ms-2" aria-label="Tutup pemberitahuan"></button>
        </div>
        <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
        <script src="~/js/job-notifications.js" asp-append-version="true"></script>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
