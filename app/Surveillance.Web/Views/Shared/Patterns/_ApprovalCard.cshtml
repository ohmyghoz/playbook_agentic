@* Pattern: approval card with the memo and three decisions. Module: wwwroot/js/patterns/approval-card.js *@
<div data-pattern="approval-card">
    <div data-part="approvals" class="mt-3"></div>
    <template data-part="approval-template">
        <article class="approval card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong class="approval-title"></strong>
                <span class="approval-state small"></span>
            </div>
            <div class="card-body">
                <div class="memo"></div>
                <form class="approval-form mt-3 border-top pt-3">
                    <div class="row g-2">
                        <div class="col-12 small text-muted">Keputusan dicatat atas nama @User.Identity?.Name.</div>
                        <div class="col-12">
                            <label class="form-label small">Komentar (wajib untuk revisi dan tolak)</label>
                            <textarea name="Comment" class="form-control form-control-sm" rows="2" maxlength="2000"></textarea>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="submit" name="Decision" value="approve" class="btn btn-success btn-sm">Setujui memo</button>
                        <button type="submit" name="Decision" value="revise" class="btn btn-outline-primary btn-sm">Minta revisi</button>
                        <button type="submit" name="Decision" value="reject" class="btn btn-outline-danger btn-sm">Tolak memo</button>
                    </div>
                    <div class="approval-message small mt-2" role="status"></div>
                </form>
            </div>
        </article>
    </template>
</div>
