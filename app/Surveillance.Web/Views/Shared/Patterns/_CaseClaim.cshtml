@* Pattern: case claim. Shows who holds a waiting case; the analyst takes it before deciding.
   Module: wwwroot/js/patterns/case-claim.js *@
<div data-pattern="case-claim" data-part="claim" class="claim alert alert-light border small d-none" role="status">
    <span data-part="claim-text"></span>
    <button type="button" data-part="claim-take" class="btn btn-sm btn-primary ms-2">Ambil kasus</button>
    <button type="button" data-part="claim-release" class="btn btn-sm btn-outline-secondary ms-2">Lepas</button>
</div>
