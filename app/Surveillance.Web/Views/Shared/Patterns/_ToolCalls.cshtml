@* Pattern: tool calls with friendly labels and the step counter. Module: wwwroot/js/patterns/tool-calls.js *@
<section data-pattern="tool-calls" aria-label="Panggilan data">
    <h2 class="h6 text-uppercase text-muted">
        Panggilan data <span data-part="tool-count" class="badge text-bg-light"></span>
    </h2>
    <ol data-part="tool-calls" class="tool-calls list-unstyled"></ol>
</section>
