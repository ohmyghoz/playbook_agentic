@* Pattern: workflow progress driven by step_started (CHANGE-001). Module: wwwroot/js/patterns/step-progress.js *@
<section data-pattern="step-progress" aria-label="Tahap investigasi">
    <h2 class="h6 text-uppercase text-muted">Tahap investigasi</h2>
    <ol data-part="steps" class="steps list-unstyled">
        <li data-step="measure"><span class="step-mark" aria-hidden="true"></span>Mengukur penyimpangan <span class="step-state small"></span></li>
        <li data-step="explain"><span class="step-mark" aria-hidden="true"></span>Mencari penjelasan wajar <span class="step-state small"></span></li>
        <li data-step="deep_dive"><span class="step-mark" aria-hidden="true"></span>Menggali broker dan arus asing <span class="step-state small"></span></li>
        <li data-step="assess"><span class="step-mark" aria-hidden="true"></span>Menilai bukti <span class="step-state small"></span></li>
        <li data-step="memo"><span class="step-mark" aria-hidden="true"></span>Draf memo menunggu keputusan analis <span class="step-state small"></span></li>
    </ol>
</section>
