@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="py-4" style="max-width: 40rem">
    <p class="text-muted small mb-1">Kode @Model.StatusCode</p>
    <h1 class="h3">@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="btn btn-primary btn-sm" asp-controller="Investigation" asp-action="Index">Ke daftar investigasi</a>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mt-4 mb-0">
            Bila perlu melapor ke tim aplikasi, sertakan ID permintaan ini: <code>@Model.RequestId</code>
        </p>
    }
</div>
