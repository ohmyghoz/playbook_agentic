@model InvestigationDetailsViewModel
@inject Microsoft.Extensions.Options.IOptions<Surveillance.Web.Investigations.TransportOptions> TransportSettings
@{
    var c = Model.Case;
    var id = new System.Globalization.CultureInfo("id-ID");
    ViewData["Title"] = $"{c.Symbol} {c.AnomalyDate:yyyy-MM-dd}";
    var terminal = c.Status.IsTerminal();
    var live = !Model.Replay && !terminal;
}

@* The page is assembled from one partial per UI pattern (Views/Shared/Patterns); see docs/PATTERNS.md. *@
<div id="investigation" data-agent-ui
     data-case-id="@c.Id"
     data-mode="@(Model.Replay ? "replay" : "live")"
     data-terminal="@(terminal ? "true" : "false")"
     data-events-url="@Url.Action("Events", new { id = c.Id })"
     data-events-json-url="@Url.Action("EventsJson", new { id = c.Id })"
     data-approval-url="@Url.Action("Approval", new { id = c.Id })"
     data-stop-url="@Url.Action("Stop", new { id = c.Id })"
     data-preview-url-template="@Url.Action("ToolPreview", new { id = c.Id, toolCallId = "__call__" })"
     data-transport="@Model.Transport"
     data-hub-url="@Url.Content("~" + Surveillance.Web.Hubs.InvestigationHub.Path)"
     data-polling-interval="@TransportSettings.Value.PollingIntervalMilliseconds"
     data-claim-url="@Url.Action("Claim", new { id = c.Id })"
     data-release-url="@Url.Action("Release", new { id = c.Id })"
     data-user="@User.Identity?.Name"
     data-decisions="@System.Text.Json.JsonSerializer.Serialize(c.Decisions.Select(d => new { approvalId = d.ApprovalId, decision = d.Decision, comment = d.Comment, decidedBy = d.DecidedBy }))">

    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">@c.Symbol · @c.AnomalyDate.ToString("d MMMM yyyy", id)</h1>
            <div class="text-muted small">
                Pemicu: @Model.Trigger.Rule · Agent: @c.Provider · Kasus @c.Id.ToString()[..8]
                · <a asp-action="Audit" asp-route-id="@c.Id">Garis waktu audit</a>
            </div>
        </div>
        <div class="d-flex align-items-start gap-2">
            <span data-part="status" class="status status-@c.Status.ToString().ToLowerInvariant()" aria-live="polite">@CaseStatusText.Label(c.Status)</span>
            <span data-part="connection" class="small text-muted" aria-live="polite"></span>
            @if (live)
            {
                <partial name="Patterns/_StopButton" />
            }
        </div>
    </div>
    @if (live)
    {
        <p class="small text-muted mb-3">
            Investigasi tetap berjalan di server walau tab ini ditutup. Buka halaman ini lagi kapan saja untuk melihat
            kelanjutannya. Untuk menghentikannya, pilih <strong>Hentikan investigasi</strong>.
        </p>
    }

    @if (Model.Replay)
    {
        <div class="replay-bar card card-body py-2 mb-3 d-flex flex-row flex-wrap align-items-center gap-2">
            <span class="small">Putar ulang event dari database.</span>
            <label for="replay-speed" class="small ms-auto">Kecepatan</label>
            <select id="replay-speed" data-part="replay-speed" class="form-select form-select-sm w-auto">
                <option value="1">1x (waktu asli)</option>
                <option value="4" selected>4x</option>
                <option value="0">Langsung semua</option>
            </select>
            <button data-part="replay-start" type="button" class="btn btn-sm btn-primary">Putar</button>
            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Kembali ke tampilan langsung</a>
        </div>
    }

    <partial name="Patterns/_ErrorBanner" model="c.Id" />

    <div class="row g-4">
        <div class="col-lg-7">
            <partial name="Patterns/_Narrative" />
            <partial name="Patterns/_ThinkingIndicator" />
            <partial name="Patterns/_CaseClaim" />
            <partial name="Patterns/_ApprovalCard" />
        </div>

        <div class="col-lg-5">
            <partial name="Patterns/_StepProgress" />
            <partial name="Patterns/_ToolCalls" />
            <partial name="Patterns/_Evidence" />

            @if (c.Decisions.Count > 0)
            {
                <h2 class="h6 text-uppercase text-muted mt-4">Keputusan analis</h2>
                <ul class="list-unstyled small">
                    @foreach (var d in c.Decisions)
                    {
                        <li class="mb-2">
                            <strong>@CaseStatusText.DecisionLabel(d.Decision)</strong> oleh @d.DecidedBy,
                            @d.DecidedAt.ToString("dd-MM-yyyy HH.mm") UTC
                            @if (d.Comment is not null)
                            {
                                <div class="text-muted">"@d.Comment"</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="Patterns/_AgentUiScripts" model="@(Model.Transport == "signalr")" />
}
