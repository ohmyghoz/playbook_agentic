<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Arsitektur use case 2" id="architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Solusi agentic AI untuk use case 2: deteksi akumulasi-distribusi terpola&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Satu aplikasi, satu kontrak (IAgentClient dan katalog event), tiga solusi agent yang bisa dipertukarkan. Keluaran agent adalah indikasi untuk ditelaah analis, bukan kesimpulan pelanggaran.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1800" height="56" as="geometry" />
        </mxCell>
        <mxCell id="analyst" value="Analis / supervisor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Halaman Jobs dan detail job&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;panel per worker, kartu laporan, tombol stop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;transport: SSE, polling, SignalR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Aplikasi .NET MVC (Surveillance.Web)&lt;/b&gt;" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;collapsible=0;fontSize=14;whiteSpace=wrap;container=1;pointerEvents=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="160" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JobsController · InvestigationController&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tanpa rujukan framework agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="50" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runner" value="&lt;b&gt;PatternJobRunner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BackgroundService, antrean job&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;job jalan terus walau browser ditutup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="screen" value="&lt;b&gt;Penyaringan awal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CandidateScreening: kode dengan ambang,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bukan agent; maks 10 kandidat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="app">
          <mxGeometry x="280" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;InvestigationService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CaseStateMachine: status kasus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;buat job, luncurkan, terima keputusan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="260" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;AgentClientRegistry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IAgentClient: StartAsync, StreamAsync,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ResumeAsync · fake | maf | langgraph | adk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="280" y="260" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bcast" value="&lt;b&gt;EventBroadcaster&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SSE · polling · SignalR (grup per kasus)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JobNotifier: notifikasi job selesai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="380" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pump" value="&lt;b&gt;RunPump&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;membaca StreamAsync, menyimpan setiap&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;event, lalu menyiarkannya&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="280" y="380" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gov" value="&lt;b&gt;Tata kelola approval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CaseClaims: ambil dan alihkan kasus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ApprovalExpiryService: kedaluwarsa&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AuditTimeline: siapa memutuskan apa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="500" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Azure SQL (sumber kebenaran)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kasus dan job, event, pratinjau data,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keputusan analis, audit; lewat repository&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="app">
          <mxGeometry x="280" y="500" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="appnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Database aplikasi menyimpan semua event dan keputusan. State internal framework hanya untuk melanjutkan eksekusi.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="app">
          <mxGeometry x="20" y="630" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Solusi agent (satu dari tiga, dipilih di halaman Setting)&lt;/b&gt;" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;collapsible=0;fontSize=14;whiteSpace=wrap;container=1;pointerEvents=0;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="620" height="700" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="&lt;b&gt;Orchestrator (kode, tanpa model)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bagi kandidat ke worker, paling banyak 3 paralel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ikuti broker: 3 teratas, porsi ≥ 40%, sebaran ≤ 30%&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kedalaman ≤ 2, saham ≤ 15, bentuk klaster&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;anggaran job: 150 tool call, 20 menit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="180" y="46" width="270" height="128" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="&lt;b&gt;Worker (model), 12 langkah per worker, diakhiri finish_worker&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="agent">
          <mxGeometry x="40" y="210" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wstock" value="&lt;b&gt;Worker saham&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;harga, volume, konsentrasi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;broker satu saham&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="workers">
          <mxGeometry x="10" y="30" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="wbroker" value="&lt;b&gt;Worker broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;broker yang sama di saham&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lain → jejak saham baru&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="workers">
          <mxGeometry x="195" y="30" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="wown" value="&lt;b&gt;Worker kepemilikan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pemegang saham sama atau&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;terafiliasi dalam klaster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="workers">
          <mxGeometry x="380" y="30" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Penyusun laporan (model)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hanya punya submit_report,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;yang menunggu approval analis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="agent">
          <mxGeometry x="70" y="390" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;Validasi laporan (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;klaster sama dengan orchestrator,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bukti merujuk tool call nyata,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tidak sah: kembali ke model, maks 2 kali&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="350" y="390" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="impl_t" value="&lt;b&gt;Implementasi, orchestrator dan aturan sama di ketiganya&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="agent">
          <mxGeometry x="20" y="500" width="580" height="24" as="geometry" />
        </mxCell>
        <mxCell id="maf" value="&lt;b&gt;MAF · C# in-process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ChatClientAgent, AIFunctionFactory,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ApprovalRequiredAIFunction&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model gpt-5-mini&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="20" y="530" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;LangGraph · service :8101&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;StateGraph, interrupt(),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AsyncSqliteSaver&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model qwen/qwen3.8-27b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="220" y="530" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="adk" value="&lt;b&gt;Google ADK · service :8102&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LlmAgent, Runner, McpToolset,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;request_confirmation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model gemini-3.8-flash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="420" y="530" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="agentnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;MAF berjalan di dalam aplikasi. LangGraph dan ADK adalah service FastAPI dengan kontrak HTTP yang sama: POST /runs, GET /runs/{id}/events (SSE), POST /runs/{id}/resume, POST /runs/{id}/cancel.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="agent">
          <mxGeometry x="20" y="640" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP idx server :8765&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hanya baca, token Bearer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;penyaringan: idx_screen, idx_history&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;worker saham: idx_history, idx_technical, idx_broker, idx_foreign, idx_news, idx_corporate_actions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;worker broker: idx_broker, idx_market_brokers, idx_members, idx_screen&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;worker kepemilikan: idx_ownership_ticker, _graph, _entity, _changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1700" y="170" width="320" height="250" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Penyedia model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenAI: gpt-5-mini (MAF)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenRouter: qwen/qwen3.8-27b (LangGraph)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Google AI Studio: gemini-3.8-flash (ADK)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="500" width="320" height="110" as="geometry" />
