        <mxCell id="src" value="&lt;b&gt;Sumber data pasar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;data publik bursa (tertunda)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stockbit: sesi login milik pengguna&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;register kepemilikan &amp;gt; 1%, bulanan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IPOT: HTTP 502, tidak dipakai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
