<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Arsitektur use case 1" id="architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Solusi agentic AI untuk use case 1: Investigator UMA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Satu agent menyelidiki satu saham yang harga atau volumenya menyimpang, lalu menyusun draf memo yang menunggu keputusan analis. Satu kontrak (IAgentClient dan katalog event), tiga solusi yang bisa dipertukarkan. Keluaran agent adalah indikasi untuk ditelaah analis, bukan kesimpulan pelanggaran.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1800" height="56" as="geometry" />
        </mxCell>
        <mxCell id="analyst" value="Analis / supervisor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Halaman investigasi:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;narasi, indikator berpikir, tool call,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;progres 5 tahap, bukti, stop,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;error, kartu memo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;transport: SSE, polling, SignalR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Aplikasi .NET MVC (Surveillance.Web)&lt;/b&gt;" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;collapsible=0;fontSize=14;whiteSpace=wrap;container=1;pointerEvents=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="160" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="&lt;b&gt;InvestigationController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mulai, events (SSE), events.json,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;approval, stop, pratinjau bukti&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;Formulir investigasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;analis mengisi kode saham, tanggal,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pemicu (harga, volume, keduanya),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;angka teramati, catatan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="280" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;InvestigationService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CaseStateMachine: status kasus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;buat kasus, luncurkan, keputusan, stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;AgentClientRegistry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IAgentClient: StartAsync, StreamAsync,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ResumeAsync · fake | maf | langgraph | adk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="280" y="170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bcast" value="&lt;b&gt;EventBroadcaster&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SSE · polling · SignalR (grup per kasus)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pratinjau data tidak ikut dikirim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pump" value="&lt;b&gt;RunPump&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;membaca StreamAsync, menyimpan setiap&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;event, memisahkan pratinjau data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="280" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gov" value="&lt;b&gt;Tata kelola approval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;antrean approval, CaseClaims,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ApprovalExpiryService (24 jam),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AuditTimeline dan ekspor JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="410" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Azure SQL (sumber kebenaran)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kasus, event, pratinjau data mentah&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(tabel terpisah, maks 8 KB),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keputusan analis, audit&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="app">
          <mxGeometry x="280" y="410" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="appnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Spesifikasi menyebut kode deteksi awal sebagai sumber kasus; di aplikasi contoh analis mengisinya sendiri. Agent tidak memilih saham sendiri. Database aplikasi menyimpan semua event dan keputusan; state internal framework hanya untuk melanjutkan eksekusi setelah restart.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="app">
          <mxGeometry x="20" y="560" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Solusi agent (satu dari tiga, dipilih di halaman Setting)&lt;/b&gt;" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;collapsible=0;fontSize=14;whiteSpace=wrap;container=1;pointerEvents=0;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="620" height="700" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="&lt;b&gt;Agent Investigator UMA (model)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;instruksi sistem yang sama di ketiga solusi (ASD)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;menulis narasi, memanggil tool, menilai bukti,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lalu memanggil submit_memo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="agent">
          <mxGeometry x="170" y="50" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;Allowlist tool MCP (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hanya 10 tool di ASD yang didaftarkan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ke agent; tool lain tidak ada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="20" y="200" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="limit" value="&lt;b&gt;Batas langkah (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;15 tool MCP per run, termasuk revisi;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lewat batas: step_limit_exceeded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="330" y="200" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="steps" value="&lt;b&gt;Penentu tahap (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dari nama tool, bukan dari model:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;measure → explain → deep_dive → assess → memo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="20" y="310" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="summ" value="&lt;b&gt;Ringkasan dan sumber (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;summary ≤ 500 karakter, source,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;resultPreview ≤ 8 KB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="330" y="310" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="memo" value="&lt;b&gt;submit_memo + validasi memo (kode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;memo harus sesuai skema, setiap evidence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;merujuk toolCallId nyata; lalu jeda approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="agent">
          <mxGeometry x="170" y="420" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="impl_t" value="&lt;b&gt;Implementasi, instruksi dan aturan sama di ketiganya&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="agent">
          <mxGeometry x="20" y="515" width="580" height="24" as="geometry" />
        </mxCell>
        <mxCell id="maf" value="&lt;b&gt;MAF · C# in-process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ChatClientAgent,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ApprovalRequiredAIFunction,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ToolLimits, MemoValidator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model gpt-5-mini&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="20" y="545" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;LangGraph · service :8101&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;StateGraph: agent, tools,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;review (interrupt()), nudge;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AsyncSqliteSaver&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model qwen/qwen3.8-27b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="220" y="545" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="adk" value="&lt;b&gt;Google ADK · service :8102&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LlmAgent, Runner,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SubmitMemoTool:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;request_confirmation;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DatabaseSessionService&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model gemini-3.8-flash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="agent">
          <mxGeometry x="420" y="545" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="agentnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;LangGraph dan ADK memakai kontrak HTTP yang sama: POST /runs, GET /runs/{id}/events (SSE), POST /runs/{id}/resume, POST /runs/{id}/cancel. Jeda approval bertahan saat service dinyalakan ulang.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="agent">
          <mxGeometry x="20" y="660" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP idx server :8765&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hanya baca, token Bearer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sekali di awal: idx_stockbit_status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ukur: idx_quote, idx_history&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;penjelasan: idx_news, idx_stockbit_actions (cadangan idx_corporate_actions)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;penggalian: idx_broker, idx_bandar, idx_foreign, idx_stockbit_movements&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tidak boleh: idx_orderbook, idx_intraday, idx_stockbit_login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1700" y="330" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Penyedia model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenAI: gpt-5-mini (MAF)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenRouter: qwen/qwen3.8-27b (LangGraph)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Google AI Studio: gemini-3.8-flash (ADK)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;coba ulang maks 2 kali, lalu model_error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="170" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src" value="&lt;b&gt;Sumber data pasar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;data publik bursa (tertunda)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stockbit: sesi login milik pengguna&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IPOT: idx_bandar bisa gagal (HTTP 502)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="2080" y="400" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="mulai investigasi,&lt;br&gt;putuskan memo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analyst" target="browser">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-55" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="POST /start · /approval&lt;br&gt;· /stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="ctl">
          <mxGeometry relative="1" as="geometry" />
